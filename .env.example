# Copy to .env and fill in. Never commit .env with real values.
# Every variable here maps to a setting in config/gateway.json and
# overrides it when set (UAG_ prefix).

# Admin API bearer token. REQUIRED for /admin/* endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
UAG_ADMIN_TOKEN=

# Bind address and port for the gateway HTTP server.
UAG_HOST=127.0.0.1
UAG_PORT=8008

# Directory for SQLite databases, the master key file, and logs.
UAG_DATA_DIR=data

# Optional: Fernet master key for keystore encryption (44-char base64).
# If unset, one is generated and stored at <data_dir>/.master_key (0600).
# If you set this, back it up: losing it makes stored keys unreadable.
UAG_MASTER_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR.
UAG_LOG_LEVEL=INFO

# Require the admin bearer token on the public /v1/* API too.
# Keep false for local use; set true when exposing the gateway.
UAG_REQUIRE_PUBLIC_AUTH=false

# Optional: path to an alternate config file.
# UAG_CONFIG_PATH=config/gateway.json
